{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing RBAC roles and verification status.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["guest", "minor", "adult_verified", "moderator", "admin"] },
        "birthDate": { "type": "string" },
        "age": { "type": "number" },
        "dni": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "role"]
    },
    "TableSession": {
      "title": "Table Session",
      "description": "An RPG table session listed by a GM.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "system": { "type": "string" },
        "ownerId": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed", "completed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "ownerId", "status", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles with their RBAC roles."
    },
    "tables/{tableId}": {
      "schema": { "$ref": "#/entities/TableSession" },
      "description": "RPG Table sessions."
    }
  }
}
